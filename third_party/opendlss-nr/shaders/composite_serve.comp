#version 460
// The serve path's composite: the network's head and the proxy image in, RGBA8 out.
//
// Same arithmetic as the host spelling in src/main.cpp (`composed`) and the demo's
// nr_composite.comp, so what this publishes is what the parity gate compares against:
//
//   neural = clamp(proxy + head / 4, 0, 1)      published through the half grid
//
// It exists because the host spelling of that is ~130ms a frame at 1440p — 11M pixels by
// three channels of fma, floor and half-truncation — and because the head is 16 bytes per
// padded pixel, so publishing it on the host means reading 60MB back per frame where the
// finished image is 14.7MB. Here it is one dispatch and the readback is the picture.
//
// The truncation to the half grid is the composite's publication of the neural result
// (`truncateHalf` in src/main.cpp): toward zero, not to nearest, so it cannot be spelled
// with roundF16 and is done on the bits.
//
// ---- the history half: the reprojection and the five-tap Catmull-Rom
//
// The history is the previous published frame, and it is read where this pixel's colour was
// in the previous frame, with the demo's five-tap reconstruction — `historySample` in
// demo/shaders/nr_common.glsl, which docs/frame.md's "History reconstruction" names. The
// demo's own words for why it is five taps and not a bilinear one: "a box or bilinear filter
// here softens the image frame over frame, because the history is fed back into the network's
// input".
//
//   * The reprojection. The client's field is current -> previous, in work-resolution pixels,
//     y down — guides.py's own units, "NGX consumes current-to-previous motion in pixel
//     units" — and the demo's motionTex is that same vector in uv units of the render target.
//     So `pixel + 0.5 + motion` is the demo's `historyUv * valid`: the same expression, with
//     the units the wire carries. Staying in pixels rather than going through uv and back is
//     what makes a zero field land exactly on a texel centre, where the five-tap below is the
//     centre tap and nothing else — the byte this published before the filter existed. That
//     is the property a run on the box can check; it is not checkable in uv.
//   * The five-tap. The demo samples five positions with textureLod and combines them with the
//     bilinear-weight trick. The history here is a buffer and not a sampled image, so the four
//     axis taps and the centre are fetched by the bilinear a texture unit does for the demo,
//     spelled out in historyFetch: the same tap positions, the same Catmull-Rom weights, the
//     same order of combination, the same clamp to the valid rectangle and the same normalize
//     by the weight sum. experiments/opendlss_port/check_composite.py transliterates both and
//     compares them rather than taking this comment's word for it.
//   * What the field does not carry. The demo's motionTex has a third component — "is there a
//     history at that previous position" — a flag rather than a value, because zero motion
//     means the history is at this same pixel and so cannot also stand for "there is none"
//     (docs/frame.md). The client's field has no room for it. The one case readable from the
//     position itself is a reprojection that leaves the valid rectangle: those pixels have no
//     history to read and the blend is skipped, which is the demo's treatment of a pixel whose
//     previous position was off screen. Disocclusion — a previous position that was on screen
//     but belonged to another surface — is invisible to both, and stays the network's per-pixel
//     blend logit to reject, as the demo says it always was.
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Push {
  uint proxyWidth;    // the proxy's stride: frames are uploaded at the valid size
  uint headWidth;     // the head's stride: rows are padded to a multiple of 64
  uint validWidth;
  uint validHeight;
  float blendScale;   // block70.layer0.blend_scale: the learned cap on the blend weight
  uint historyValid;  // 1: blend with the previous published frame; 0: publish the residual alone
} pc;

layout(std430, binding = 0) readonly buffer Proxy { vec4 proxy[]; };
// The previous frame, through the same proxy transform, at the source's own stride (the serve
// path builds it with proxy_expand.comp). Always bound; pc.historyValid says whether it is read.
layout(std430, binding = 1) readonly buffer History { vec4 history[]; };
// The client's motion field: 2 x f16 per pixel, current -> previous, work-resolution pixels, y
// down. Always bound; a caller that declares no field sends none and this reads zeros, which is
// the identity reprojection and the centre tap.
layout(std430, binding = 2) readonly buffer Motion { uint motionField[]; };
layout(std430, binding = 6) readonly buffer Head { vec4 head[]; };
layout(std430, binding = 7) writeonly buffer Out { uint pixels[]; };   // RGBA8, little-endian

float truncateHalf(float value) {
  uint bits = floatBitsToUint(value);
  uint signBit = (bits >> 16u) & 0x8000u;
  uint exponent = (bits >> 23u) & 0xffu;
  uint mantissa = bits & 0x7fffffu;
  uint halfBits;
  if (exponent == 0xffu) halfBits = signBit | (mantissa != 0u ? 0x7e00u : 0x7c00u);
  else {
    int halfExponent = int(exponent) - 112;
    if (halfExponent >= 31) halfBits = signBit | 0x7c00u;
    else if (halfExponent <= 0)
      halfBits = halfExponent < -10 ? signBit
                                    : signBit | ((mantissa | 0x800000u) >> uint(14 - halfExponent));
    else halfBits = signBit | (uint(halfExponent) << 10u) | (mantissa >> 13u);
  }
  return unpackHalf2x16(halfBits).x;
}

// proxy + head / 4, unclamped to the half grid: the truncation is a publication step and happens
// once, after the blend (docs/frame.md's `history' = truncate_to_half(neural)`). With no history
// the blend is skipped and this is the whole of it, exactly as before.
float composeChannel(float headValue, float centredProxy) {
  const float inner = fma(headValue, 0.03125, centredProxy);       // head / 32 + centred
  return clamp(inner * 8.0 + 0.5, 0.0, 1.0);                       // proxy + head / 4
}

uint toByte(float value) {
  return uint(clamp(floor(value * 255.0 + 0.5), 0.0, 255.0));
}

// One bilinear fetch of the history at `p`, a position in "pixel + 0.5" units — where the demo's
// `historyUv * valid` lands. Texel (x, y) covers [x, x + 1) and its centre is at x + 0.5, so the
// texel the position starts in is p - 0.5 floored. The history is a buffer, not a sampled image,
// so this is the bilinear a texture unit would do for the demo's textureLod — with the same clamp
// to the valid rectangle, which is what the sampler's address mode does there.
vec3 historyFetch(vec2 p) {
  vec2 base = floor(p - 0.5);
  vec2 t = (p - 0.5) - base;
  ivec2 last = ivec2(int(pc.validWidth), int(pc.validHeight)) - 1;
  ivec2 lo = clamp(ivec2(base), ivec2(0), last);
  ivec2 hi = clamp(ivec2(base) + 1, ivec2(0), last);
  vec3 topLeft = history[lo.y * pc.proxyWidth + lo.x].rgb;
  vec3 topRight = history[lo.y * pc.proxyWidth + hi.x].rgb;
  vec3 bottomLeft = history[hi.y * pc.proxyWidth + lo.x].rgb;
  vec3 bottomRight = history[hi.y * pc.proxyWidth + hi.x].rgb;
  return mix(mix(topLeft, topRight, t.x), mix(bottomLeft, bottomRight, t.x), t.y);
}

// historySample: the demo's five-tap Catmull-Rom reconstruction of the history at `position`
// (which is `pixel + 0.5 + motion`, the demo's historyUv * valid). The four axis taps and the
// centre, with the bilinear-weight trick: the centre position is offset by w2 / middle so that
// the bilinear fetch's two weights are the two middle Catmull-Rom taps, and the combination is
// normalized by the weight sum, whose value the demo leaves to the expression rather than to 1.
vec3 historySample(vec2 position) {
  vec2 valid = vec2(pc.validWidth, pc.validHeight);
  vec2 base = floor(position - 0.5) + 0.5;
  vec2 f = clamp(position - base, vec2(0.0), vec2(1.0));
  vec2 square = f * f;
  vec2 cube = f * square;
  vec2 w0 = fma(f + cube, vec2(-0.5), square);
  vec2 w1 = (cube * 1.5 - square * 2.5) + 1.0;
  vec2 w3 = (cube - square) * 0.5;
  vec2 w2 = ((1.0 - w0) - w1) - w3;
  vec2 middle = w1 + w2;
  vec2 low = clamp(base - 1.0, vec2(0.5), valid - 0.5);
  vec2 center = clamp(base + w2 / middle, vec2(0.5), valid - 0.5);
  vec2 high = clamp(base + 2.0, vec2(0.5), valid - 0.5);
  vec3 left = historyFetch(vec2(low.x, center.y));
  vec3 top = historyFetch(vec2(center.x, low.y));
  vec3 mid = historyFetch(center);
  vec3 bottom = historyFetch(vec2(center.x, high.y));
  vec3 right = historyFetch(vec2(high.x, center.y));
  float a = w0.x * middle.y; float b = w0.y * middle.x;
  float c = middle.x * middle.y; float d = w3.y * middle.x; float e = w3.x * middle.y;
  vec3 value = fma(left, vec3(a), top * b);
  value = fma(mid, vec3(c), value);
  value = fma(bottom, vec3(d), value);
  value = fma(right, vec3(e), value);
  return value * (1.0 / (e + (d + (c + (a + b)))));
}

// The history's own "is there one here": where this pixel was in the previous frame, in "pixel
// + 0.5" units. The demo reads the flag out of the motion texture's third component; the wire's
// field carries no flag, so the composite's only per-pixel test is the rectangle below.
vec2 historyPosition(vec2 pixel, uint index) {
  return pixel + 0.5 + unpackHalf2x16(motionField[index]);
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= pc.validWidth || id.y >= pc.validHeight) return;
  uint index = id.y * pc.proxyWidth + id.x;
  vec4 source = proxy[index];
  vec4 neural = head[id.y * pc.headWidth + id.x];
  vec3 centred = fma(source.rgb, vec3(0.125), vec3(-0.0625));
  vec3 value = vec3(composeChannel(neural.r, centred.r),
                    composeChannel(neural.g, centred.g),
                    composeChannel(neural.b, centred.b));
  if (pc.historyValid != 0u) {
    // docs/frame.md's composition: weight = clamp(sigmoid(head.a) * blendScale, 0, 1), then
    // value = lerp(value, history, weight). The sigmoid is the demo's own expression, constant
    // and all: 1 / (1 + exp2(-x * 1.442695)), i.e. 1 / (1 + e^-x) written as the demo writes it.
    // The history is the previous published frame, sampled where the motion field says this pixel
    // was — the reprojection and the five-tap above. A zero field puts that position at this same
    // pixel's centre, so the sample is the pixel itself and this is the blend as it was measured
    // (r2026-10-12-d) to the byte. A position outside the valid rectangle is a pixel with no
    // history to read (the demo's own hasHistory), and the blend is skipped for it.
    vec2 position = historyPosition(vec2(id), index);
    vec2 valid = vec2(pc.validWidth, pc.validHeight);
    if (all(greaterThanEqual(position, vec2(0.5))) &&
        all(lessThanEqual(position, valid - 0.5))) {
      float scale = clamp(pc.blendScale, 0.0, 1.0);
      float weight = clamp((1.0 / (1.0 + exp2(neural.a * uintBitsToFloat(0xbfb8aa3bu)))) * scale,
                           0.0, 1.0);
      vec3 historyValue = historySample(position);
      value = fma(vec3(weight), historyValue - value, value);
    }
  }
  // The publication point, once, after the blend.
  value = vec3(truncateHalf(value.r), truncateHalf(value.g), truncateHalf(value.b));
  uvec3 bytes = uvec3(toByte(value.r), toByte(value.g), toByte(value.b));
  pixels[id.y * pc.validWidth + id.x] =
      bytes.r | (bytes.g << 8u) | (bytes.b << 16u) | (255u << 24u);
}
