#!/usr/bin/env bash
# Desktop launcher (moonglide.desktop): if MoonGlide is already running, bring it to the front
# with its app UI open; otherwise start it (as the transient user unit "moonglide", like the
# live setup) with the UI open. Settings come from ~/.config/moonglide/config.toml.
set -uo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Which binary: $MOONGLIDE_BIN, else an optional local wrapper (scripts/run-*.sh, git-ignored: set
# DISPLAY/XAUTHORITY or paths there), else a build next to this script, else `moonglide` on PATH.
run="${MOONGLIDE_BIN:-}"
if [ -z "$run" ]; then
  for f in "$root"/scripts/run-*.sh; do [ -x "$f" ] && run="$f" && break; done
fi
[ -z "$run" ] && [ -x "$root/build/moonglide" ] && run="$root/build/moonglide"
[ -z "$run" ] && run="$(command -v moonglide || true)"
[ -n "$run" ] || { echo "moonglide not found: build it or set MOONGLIDE_BIN" >&2; exit 1; }
ctl="${MOONGLIDE_CTL:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/moonglide.ctl}"
if [ -p "$ctl" ] && pgrep -u "$(id -u)" -x moonglide > /dev/null; then
  # A fifo write blocks without a reader: give up after 2 s and start a new one instead.
  if timeout 2 sh -c 'echo "ui show" > "$1"' _ "$ctl"; then exit 0; fi
fi
if command -v systemd-run > /dev/null && systemctl --user show-environment > /dev/null 2>&1; then
  exec systemd-run --user --collect --quiet --unit moonglide \
    --setenv=DISPLAY="${DISPLAY:-:0}" ${XAUTHORITY:+--setenv=XAUTHORITY="$XAUTHORITY"} \
    "$run" --ui "$@"
fi
exec "$run" --ui "$@" >> /dev/shm/moonglide.log 2>&1
