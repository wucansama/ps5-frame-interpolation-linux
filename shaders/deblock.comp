#version 460
#extension GL_GOOGLE_include_directive : require
// MJPEG deblocking on the 8x8 DCT grid (capture resolution, grid anchored at 0,0), one
// direction per dispatch. H.264-style weak filter: a boundary is only touched when the step
// across it is small and both sides are flat, i.e. it looks like quantisation, not an edge.
layout(local_size_x = 16, local_size_y = 16) in;
#include "common.glsl"

layout(push_constant) uniform Push {
  uint width, height;
  uint vertical;      // 0: filter vertical block edges (x = 8k), 1: horizontal edges (y = 8k)
  float strength;     // scales the thresholds; 0 = off
} pc;
layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };

vec3 at(ivec2 p) {
  p = clamp(p, ivec2(0), ivec2(pc.width - 1u, pc.height - 1u));
  return unpackPixel(src[uint(p.y) * pc.width + uint(p.x)]).rgb;
}
float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= pc.width || id.y >= pc.height) return;
  ivec2 p = ivec2(id);
  ivec2 dir = pc.vertical == 0u ? ivec2(1, 0) : ivec2(0, 1);
  int along = pc.vertical == 0u ? p.x : p.y;
  int phase = along & 7;
  vec3 self = at(p);
  // Only the two pixels either side of a boundary move: p0 | q0 at phase 7 | 0.
  if ((phase != 7 && phase != 0) || along == 0 || pc.strength <= 0.0) {
    dst[id.y * pc.width + id.x] = packPixel(vec4(self, 1.0));
    return;
  }
  ivec2 b = phase == 0 ? p : p + dir;   // first pixel right of / below the boundary (q0)
  vec3 p1 = at(b - 2 * dir), p0 = at(b - dir), q0 = at(b), q1 = at(b + dir);
  float alpha = 14.0 / 255.0 * pc.strength, beta = 5.0 / 255.0 * pc.strength, tc = 3.0 / 255.0 * pc.strength;
  float lp0 = luma(p0), lq0 = luma(q0);
  bool doFilter = abs(lp0 - lq0) < alpha && abs(luma(p1) - lp0) < beta && abs(luma(q1) - lq0) < beta;
  vec3 o = self;
  if (doFilter) {
    vec3 delta = clamp(((q0 - p0) * 4.0 + (p1 - q1)) / 8.0, vec3(-tc), vec3(tc));
    o = phase == 7 ? p0 + delta : q0 - delta;
  }
  dst[id.y * pc.width + id.x] = packPixel(vec4(clamp(o, 0.0, 1.0), 1.0));
}
