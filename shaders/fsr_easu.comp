#version 460
#extension GL_GOOGLE_include_directive : require
// FSR 1 EASU (Edge Adaptive Spatial Upsampling), after AMD FidelityFX FSR 1.0 (MIT,
// Copyright (c) 2021 Advanced Micro Devices, Inc.): the 12-tap ring, the luma direction /
// length analysis over the four nearest bilinear quads, the stretched Lanczos-2
// approximation and the deringing clamp to the nearest 2x2, re-expressed over storage
// buffers. The intensity mix (original vs NR) is applied on load, so what EASU sees is the
// picture that will be shown.
layout(local_size_x = 16, local_size_y = 16) in;
#include "common.glsl"

layout(push_constant) uniform Push {
  uint srcW, srcH;      // input (work) size
  uint dstW, dstH;      // output (display rect) size
  float mixAmount;      // 1 = processed only
  uint origIsSrc;       // 1: no mix, read proc only
} pc;

layout(std430, binding = 0) readonly buffer Proc { uint proc[]; };
layout(std430, binding = 1) readonly buffer Orig { uint orig[]; };
layout(std430, binding = 2) writeonly buffer Dst { uint dst[]; };

vec3 tap(ivec2 p) {
  p = clamp(p, ivec2(0), ivec2(pc.srcW - 1u, pc.srcH - 1u));
  uint i = uint(p.y) * pc.srcW + uint(p.x);
  vec3 a = unpackPixel(proc[i]).rgb;
  if (pc.origIsSrc != 0u) return a;
  return mix(unpackPixel(orig[i]).rgb, a, pc.mixAmount);
}

float luma(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }

void easuSet(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {
  // lA top, lB left, lC centre, lD right, lE bottom
  float dc = lD - lC, cb = lC - lB;
  float lenX = max(abs(dc), abs(cb));
  lenX = lenX > 0.0 ? 1.0 / lenX : 0.0;
  float dirX = lD - lB;
  lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
  lenX *= lenX;
  float ec = lE - lC, ca = lC - lA;
  float lenY = max(abs(ec), abs(ca));
  lenY = lenY > 0.0 ? 1.0 / lenY : 0.0;
  float dirY = lE - lA;
  lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
  lenY *= lenY;
  dir += vec2(dirX, dirY) * w;
  len += (lenX + lenY) * w;
}

void easuTap(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len2, float lob, float clp, vec3 c) {
  vec2 v = vec2(off.x * dir.x + off.y * dir.y, off.x * (-dir.y) + off.y * dir.x) * len2;
  float d2 = min(v.x * v.x + v.y * v.y, clp);
  float wB = 0.4 * d2 - 1.0;
  float wA = lob * d2 - 1.0;
  wB *= wB;
  wA *= wA;
  wB = 1.5625 * wB - 0.5625;
  float w = wB * wA;
  aC += c * w;
  aW += w;
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= pc.dstW || id.y >= pc.dstH) return;
  vec2 pp = (vec2(id) + 0.5) * vec2(pc.srcW, pc.srcH) / vec2(pc.dstW, pc.dstH) - 0.5;
  vec2 fp = floor(pp);
  pp -= fp;
  ivec2 o = ivec2(fp);

  //    b c
  //  e f g h
  //  i j k l
  //    n o
  vec3 b = tap(o + ivec2(0, -1)), c = tap(o + ivec2(1, -1));
  vec3 e = tap(o + ivec2(-1, 0)), f = tap(o), g = tap(o + ivec2(1, 0)), h = tap(o + ivec2(2, 0));
  vec3 i = tap(o + ivec2(-1, 1)), j = tap(o + ivec2(0, 1)), k = tap(o + ivec2(1, 1)), l = tap(o + ivec2(2, 1));
  vec3 n = tap(o + ivec2(0, 2)), oo = tap(o + ivec2(1, 2));
  float bL = luma(b), cL = luma(c), eL = luma(e), fL = luma(f), gL = luma(g), hL = luma(h);
  float iL = luma(i), jL = luma(j), kL = luma(k), lL = luma(l), nL = luma(n), oL = luma(oo);

  vec2 dir = vec2(0.0);
  float len = 0.0;
  easuSet(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
  easuSet(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
  easuSet(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
  easuSet(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);

  float dirR = dot(dir, dir);
  bool zro = dirR < 1.0 / 32768.0;
  dirR = zro ? 1.0 : inversesqrt(dirR);
  dir.x = zro ? 1.0 : dir.x;
  dir *= dirR;
  len = len * 0.5;
  len *= len;
  float stretch = dot(dir, dir) / max(abs(dir.x), abs(dir.y));
  vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
  float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
  float clp = 1.0 / lob;

  vec3 aC = vec3(0.0);
  float aW = 0.0;
  easuTap(aC, aW, vec2(0.0, -1.0) - pp, dir, len2, lob, clp, b);
  easuTap(aC, aW, vec2(1.0, -1.0) - pp, dir, len2, lob, clp, c);
  easuTap(aC, aW, vec2(-1.0, 1.0) - pp, dir, len2, lob, clp, i);
  easuTap(aC, aW, vec2(0.0, 1.0) - pp, dir, len2, lob, clp, j);
  easuTap(aC, aW, vec2(0.0, 0.0) - pp, dir, len2, lob, clp, f);
  easuTap(aC, aW, vec2(-1.0, 0.0) - pp, dir, len2, lob, clp, e);
  easuTap(aC, aW, vec2(1.0, 1.0) - pp, dir, len2, lob, clp, k);
  easuTap(aC, aW, vec2(2.0, 1.0) - pp, dir, len2, lob, clp, l);
  easuTap(aC, aW, vec2(2.0, 0.0) - pp, dir, len2, lob, clp, h);
  easuTap(aC, aW, vec2(1.0, 0.0) - pp, dir, len2, lob, clp, g);
  easuTap(aC, aW, vec2(1.0, 2.0) - pp, dir, len2, lob, clp, oo);
  easuTap(aC, aW, vec2(0.0, 2.0) - pp, dir, len2, lob, clp, n);

  vec3 mn = min(min(f, g), min(j, k));
  vec3 mx = max(max(f, g), max(j, k));
  vec3 pix = clamp(aC / aW, mn, mx);
  dst[id.y * pc.dstW + id.x] = packPixel(vec4(pix, 1.0));
}
