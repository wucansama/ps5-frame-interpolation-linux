#version 460
#extension GL_GOOGLE_include_directive : require
// Copy an RGBA8 picture with an affine colour correction (the inverse of an external effect's
// measured colour error): c' = M c + t, rows of M with t in .w.
layout(local_size_x = 256) in;
#include "common.glsl"

layout(push_constant) uniform Push { uint count; uint pad0, pad1, pad2; vec4 row[3]; } pc;
layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;
  vec4 c = unpackPixel(src[i]);
  vec4 h = vec4(c.rgb, 1.0);
  dst[i] = packPixel(vec4(clamp(vec3(dot(pc.row[0], h), dot(pc.row[1], h), dot(pc.row[2], h)), 0.0, 1.0), c.a));
}
