#version 460
#extension GL_GOOGLE_include_directive : require
// Raw capture bytes (YUYV 4:2:2 or NV12 4:2:0) -> RGBA8. HDMI capture is BT.709; range is a
// push constant because devices disagree (limited is the HDMI default for YCbCr).
layout(local_size_x = 16, local_size_y = 16) in;
#include "common.glsl"

layout(push_constant) uniform Push {
  uint width;
  uint height;
  uint format;      // 2 = YUYV, 3 = NV12 (PixelFormat in capture_v4l2.h)
  uint fullRange;   // 0 = limited (16-235), 1 = full
} pc;

layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };

uint byteAt(uint i) { return (src[i >> 2] >> ((i & 3u) * 8u)) & 255u; }

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= pc.width || id.y >= pc.height) return;
  float y, u, v;
  if (pc.format == 2u) {
    uint base = (id.y * pc.width + (id.x & ~1u)) * 2u;
    y = float(byteAt(base + ((id.x & 1u) * 2u)));
    u = float(byteAt(base + 1u));
    v = float(byteAt(base + 3u));
  } else {
    y = float(byteAt(id.y * pc.width + id.x));
    uint uv = pc.width * pc.height + (id.y >> 1) * pc.width + (id.x & ~1u);
    u = float(byteAt(uv));
    v = float(byteAt(uv + 1u));
  }
  float Y, U, V;
  if (pc.fullRange != 0u) {
    Y = y / 255.0; U = (u - 128.0) / 255.0; V = (v - 128.0) / 255.0;
  } else {
    Y = (y - 16.0) / 219.0; U = (u - 128.0) / 224.0; V = (v - 128.0) / 224.0;
  }
  vec3 rgb = vec3(Y + 1.5748 * V, Y - 0.1873 * U - 0.4681 * V, Y + 1.8556 * U);
  dst[id.y * pc.width + id.x] = packPixel(vec4(rgb, 1.0));
}
