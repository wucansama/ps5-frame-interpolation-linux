#version 460
#extension GL_GOOGLE_include_directive : require
// The picture that will be shown, at the work size: NR output mixed over the original by
// intensity. Frame generation interpolates between two of these.
layout(local_size_x = 256) in;
#include "common.glsl"

layout(push_constant) uniform Push { uint count; float mixAmount; uint origIsSrc; } pc;
layout(std430, binding = 0) readonly buffer Proc { uint proc[]; };
layout(std430, binding = 1) readonly buffer Orig { uint orig[]; };
layout(std430, binding = 2) writeonly buffer Dst { uint dst[]; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;
  if (pc.origIsSrc != 0u) { dst[i] = orig[i]; return; }
  dst[i] = packPixel(mix(unpackPixel(orig[i]), unpackPixel(proc[i]), pc.mixAmount));
}
