#version 460
#extension GL_GOOGLE_include_directive : require
// FSR 1 RCAS (Robust Contrast Adaptive Sharpening), after AMD FidelityFX FSR 1.0 (MIT,
// Copyright (c) 2021 Advanced Micro Devices, Inc.): a 5-tap cross whose negative lobe is
// limited so it can never push a pixel outside its neighbourhood's range.
layout(local_size_x = 16, local_size_y = 16) in;
#include "common.glsl"

layout(push_constant) uniform Push {
  uint width, height;
  float sharpness;   // exp2(-stops): 1.0 = maximum, 0.87 = 0.2 stops (FSR's default)
} pc;

layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };

vec3 at(ivec2 p) {
  p = clamp(p, ivec2(0), ivec2(pc.width - 1u, pc.height - 1u));
  return unpackPixel(src[uint(p.y) * pc.width + uint(p.x)]).rgb;
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= pc.width || id.y >= pc.height) return;
  ivec2 p = ivec2(id);
  //   b
  // d e f
  //   h
  vec3 b = at(p + ivec2(0, -1)), d = at(p + ivec2(-1, 0)), e = at(p), f = at(p + ivec2(1, 0)), h = at(p + ivec2(0, 1));
  vec3 mn4 = min(min(b, d), min(f, h));
  vec3 mx4 = max(max(b, d), max(f, h));
  const vec2 peakC = vec2(1.0, -4.0);
  vec3 hitMin = min(mn4, e) / (4.0 * mx4 + 1e-5);
  vec3 hitMax = (peakC.x - max(mx4, e)) / (4.0 * mn4 + peakC.y);
  vec3 lobeRGB = max(-hitMin, hitMax);
  const float limit = 0.25 - 1.0 / 16.0;
  float lobe = max(-limit, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * pc.sharpness;
  vec3 pix = (lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0);
  dst[id.y * pc.width + id.x] = packPixel(vec4(pix, 1.0));
}
