#version 460
#extension GL_GOOGLE_include_directive : require
// Decoded RGBA8 -> RGBA8 with optional limited (16-235) -> full (0-255) expansion, so NR and
// everything after it always see full-range RGB. expand = 0 is a plain copy.
layout(local_size_x = 256) in;
#include "common.glsl"

layout(push_constant) uniform Push { uint count; uint expand; } pc;
layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;
  uint v = src[i];
  if (pc.expand != 0u) {
    vec4 c = unpackPixel(v);
    c.rgb = clamp((c.rgb * 255.0 - 16.0) / 219.0, 0.0, 1.0);
    v = packPixel(c);
  }
  dst[i] = v;
}
