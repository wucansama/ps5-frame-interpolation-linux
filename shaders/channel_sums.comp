#version 460
#extension GL_GOOGLE_include_directive : require
// Per-channel sums of an RGBA8 picture into sums[slot * 3 + c] (8-bit units; fits 32 bits up to
// 4K). Used to measure an external effect's colour shift: mean(out) - mean(in).
layout(local_size_x = 256) in;
#include "common.glsl"

layout(push_constant) uniform Push { uint count; uint slot; } pc;
layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) buffer Sums { uint sums[]; };

shared uint partial[3][256];

void main() {
  uint t = gl_LocalInvocationID.x;
  uvec3 acc = uvec3(0u);
  for (uint i = gl_GlobalInvocationID.x; i < pc.count; i += gl_NumWorkGroups.x * 256u) {
    uint p = src[i];
    acc += uvec3(p & 255u, (p >> 8) & 255u, (p >> 16) & 255u);
  }
  partial[0][t] = acc.r;
  partial[1][t] = acc.g;
  partial[2][t] = acc.b;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1) {
    if (t < s) {
      partial[0][t] += partial[0][t + s];
      partial[1][t] += partial[1][t + s];
      partial[2][t] += partial[2][t + s];
    }
    barrier();
  }
  if (t == 0u) {
    atomicAdd(sums[pc.slot * 3u + 0u], partial[0][0]);
    atomicAdd(sums[pc.slot * 3u + 1u], partial[1][0]);
    atomicAdd(sums[pc.slot * 3u + 2u], partial[2][0]);
  }
}
